# hsgattorneys.co.za — Apache configuration for the static site.
# Generated into dist/ by scripts/build.mjs (the redirect block is filled in from
# content/redirects.json). Edit server/.htaccess, not dist/.htaccess.

Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

# ---- HTTPS + canonical host (no www) ----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://hsgattorneys.co.za%{REQUEST_URI} [L,R=301]
  # Trailing slash on directory URLs (/practice -> /practice/)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>

# ---- Old WordPress URLs -> new pages (SEO continuity) ----
# {{REDIRECTS}}
# WordPress leftovers that should simply be gone.
RedirectMatch 410 ^/(wp-admin|wp-login\.php|xmlrpc\.php|wp-json|feed|comments/feed|tag|category|author)(/|$)
RedirectMatch 301 ^/team/?$ /team/

# ---- Security headers ----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"
  # The main site only for now. includeSubDomains would make browsers refuse plain HTTP on
  # every *.hsgattorneys.co.za (mail, webmail, …) for a year; add it back only once every
  # subdomain in use is confirmed to answer on HTTPS with a valid certificate.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Third parties are loaded only on request (YouTube / Google Maps facades) and WhatsApp is a plain link.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://www.google.com https://www.linkedin.com; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>

# ---- Compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/json application/javascript image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/xml application/json application/javascript image/svg+xml
</IfModule>

# ---- Caching: HTML always revalidates; versioned assets and images cache for a year ----
<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico|woff2|pdf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
</IfModule>

# ---- Never serve these ----
<FilesMatch "\.(md|json|jsonl|log|sql|env|bak|ini)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(mail-config|hsg-mail)\.php$">
  Require all denied
</FilesMatch>
<FilesMatch "^(leads|honeypot|testimonials)\.log\.jsonl$">
  Require all denied
</FilesMatch>
# ...except the rates file the calculators read, which the rule above would otherwise
# block too — leaving the calculators silently on the rates built into tariffs.js, so a
# rate changed in tariffs.json on the host would never take effect. (After the deny rule
# on purpose: the later section wins.)
<Files "tariffs.json">
  Require all granted
</Files>
